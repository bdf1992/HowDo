#!/usr/bin/env python3
"""Report or instantiate this installation's durable context.

The plugin-native replacement for ``install.py --verify``. It exists because
``references/onboarding.md`` used to tell the agent to run a ``sys.path`` hack
against the relative path ``runtime``, which only resolves when the process
happens to be sitting in the payload. A file on ``PATH`` has no such
requirement: a plugin host puts this directory on the Bash tool's ``PATH``
while the plugin is enabled, so ``howdo-context`` is addressable from anywhere.

    howdo-context            report the store's state
    howdo-context --ensure   instantiate it from the template if it is missing
    howdo-context --path     print the resolved store path and nothing else
    howdo-context --notice   SessionStart hook: tell the person, not the agent

Exit status is 0 when the store is usable (including a deliberate decline or
deferral) and 1 when it is invalid, forked, or absent under ``--path``.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path


def _plugin_root() -> Path:
    """Locate the payload this executable was shipped inside.

    ``CLAUDE_PLUGIN_ROOT`` is authoritative when a host sets it. Falling back
    to the executable's own parent keeps the script working under
    ``--plugin-dir``, a direct checkout, and a plain skills directory, none of
    which are guaranteed to export it.
    """
    declared = os.environ.get("CLAUDE_PLUGIN_ROOT")
    if declared:
        return Path(declared).expanduser().resolve()
    return Path(__file__).resolve().parent.parent


ROOT = _plugin_root()
sys.path.insert(0, str(ROOT / "runtime"))

try:
    from howdo.context import (  # noqa: E402
        ensure_context,
        inspect_context,
        resolve_context_path,
    )
    from howdo.notice import CONFIGURATION_NOTE, UNSETTLED  # noqa: E402
except ModuleNotFoundError:  # pragma: no cover - depends on how it was copied
    print(f"howdo-context: no runtime/ under {ROOT}", file=sys.stderr)
    print("the payload was copied by hand, or CLAUDE_PLUGIN_ROOT is wrong", file=sys.stderr)
    raise SystemExit(1)


# States that mean "do not proceed as if a context were loaded". A decline and a
# deferral are settled answers, not failures, so neither belongs here.
BROKEN = {"invalid", "fork_required"}


def notice(store: Path) -> int:
    """Say the one thing How Do says before it is asked anything.

    This runs from a `SessionStart` hook, so it is the only part of the skill
    that speaks unprompted -- and the shape of what it emits is what keeps that
    admissible. `systemMessage` reaches the person; `suppressOutput` keeps it
    out of the transcript body; neither puts a single token into the model's
    context. The skill is not loaded, no pedagogy is read, and nothing about
    the discipline is in play. A person is told that a conversation is coming
    and how to decline it.

    `additionalContext` is the field that would change that, and this function
    must never emit it. A test asserts so.

    Silence is the common case. Once the question has an answer -- settled,
    declined, or postponed -- repeating it is the nagging the discipline
    refuses, so anything outside `UNSETTLED` prints nothing at all. Empty
    stdout adds no context; that is the point of returning early rather than
    emitting an empty object.
    """
    try:
        state = inspect_context(store).state
    except Exception:
        # A hook that fails loudly on a malformed store would make every
        # session start with an error about a file the person did not ask
        # about. Staying quiet is the correct failure here.
        return 0

    if state not in UNSETTLED:
        return 0

    json.dump(
        {
            "hookSpecificOutput": {
                "hookEventName": "SessionStart",
                "systemMessage": CONFIGURATION_NOTE.strip(),
                "suppressOutput": True,
            }
        },
        sys.stdout,
    )
    sys.stdout.write("\n")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--context", type=Path, default=None,
                        help="durable context file (default: the resolved store)")
    parser.add_argument("--ensure", action="store_true",
                        help="instantiate from the shipped template if missing")
    parser.add_argument("--path", action="store_true",
                        help="print the resolved store path and exit")
    parser.add_argument("--notice", action="store_true",
                        help="SessionStart hook mode: emit the first-run notice for the "
                             "person, as systemMessage only, never as model context")
    args = parser.parse_args(argv)

    store = resolve_context_path(args.context)

    if args.path:
        print(store)
        return 0

    if args.notice:
        return notice(store)

    if args.ensure:
        status = ensure_context(store, template=ROOT / "CONTEXT.template.md")
    else:
        status = inspect_context(store)

    print(f"payload  {ROOT}")
    print(f"store    {store}")
    print(f"state    {status.state} — {status.reason}")
    return 1 if status.state in BROKEN else 0


if __name__ == "__main__":
    raise SystemExit(main())
