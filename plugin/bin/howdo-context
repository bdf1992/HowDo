#!/usr/bin/env python3
"""Report or instantiate this installation's durable context.

The plugin-native replacement for ``install.py --verify``. It exists because
``references/onboarding.md`` used to tell the agent to run a ``sys.path`` hack
against the relative path ``runtime``, which only resolves when the process
happens to be sitting in the payload. A file on ``PATH`` has no such
requirement: a plugin host puts this directory on the Bash tool's ``PATH``
while the plugin is enabled, so ``howdo-context`` is addressable from anywhere.

    howdo-context            report the store's state
    howdo-context --ensure   instantiate it from the template if it is missing
    howdo-context --path     print the resolved store path and nothing else
    howdo-context --signals  show what has been recorded about this person's work
    howdo-context --forget   delete that record; --older-than DAYS prunes part

Exit status is 0 when the store is usable (including a deliberate decline or
deferral) and 1 when it is invalid, forked, or absent under ``--path``.
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path


sys.path.insert(0, str(Path(__file__).resolve().parent))
from _howdo_bootstrap import add_runtime  # noqa: E402

ROOT = add_runtime(__file__)

try:
    from howdo.context import (  # noqa: E402
        ensure_context,
        inspect_context,
        resolve_context_path,
    )
except ModuleNotFoundError:  # pragma: no cover - depends on how it was copied
    print(f"howdo-context: no runtime/ under {ROOT}", file=sys.stderr)
    print("the payload was copied by hand, or CLAUDE_PLUGIN_ROOT is wrong", file=sys.stderr)
    raise SystemExit(1)


# States that mean "do not proceed as if a context were loaded". A decline and a
# deferral are settled answers, not failures, so neither belongs here.
BROKEN = {"invalid", "fork_required"}


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--context", type=Path, default=None,
                        help="durable context file (default: the resolved store)")
    parser.add_argument("--ensure", action="store_true",
                        help="instantiate from the shipped template if missing")
    parser.add_argument("--path", action="store_true",
                        help="print the resolved store path and exit")
    parser.add_argument("--signals", action="store_true",
                        help="show what has been recorded about this person's work")
    parser.add_argument("--forget", action="store_true",
                        help="delete the recorded signals; nothing else is touched")
    parser.add_argument("--older-than", type=float, default=None, metavar="DAYS",
                        help="with --forget, remove only entries older than DAYS")
    args = parser.parse_args(argv)

    store = resolve_context_path(args.context)

    if args.path:
        print(store)
        return 0

    if args.signals or args.forget:
        # Imported here because the ordinary paths above never need them, and
        # this script is also what the store report runs through.
        from howdo.signal import forget, resolve_signal_log, summarise  # noqa: PLC0415

        try:
            log = resolve_signal_log(context_path=store)
        except Exception as problem:
            print(problem, file=sys.stderr)
            return 1

        if args.signals:
            print("\n".join(summarise(log)))
            return 0

        import time  # noqa: PLC0415

        cutoff = time.time() - args.older_than * 86400 if args.older_than else None
        removed = forget(log, older_than=cutoff)
        scope = f" older than {args.older_than} day(s)" if args.older_than else ""
        print(f"removed {removed} recorded operation(s){scope} from {log}")
        return 0

    if args.ensure:
        status = ensure_context(store, template=ROOT / "CONTEXT.template.md")
    else:
        status = inspect_context(store)

    print(f"payload  {ROOT}")
    print(f"store    {store}")
    print(f"state    {status.state} — {status.reason}")
    return 1 if status.state in BROKEN else 0


if __name__ == "__main__":
    raise SystemExit(main())
